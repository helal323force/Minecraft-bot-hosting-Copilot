NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INITIAL_ADMIN_EMAIL=wingxmc26@gmail.com

# Firebase Admin / backend only
FIREBASE_PROJECT_ID=minecraft-bot-hosting
FIREBASE_DATABASE_URL=https://minecraft-bot-hosting-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=minecraft-bot-hosting.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=
BOT_WORKER_TOKEN=replace-with-a-long-random-worker-token
MAX_ACTIVE_BOTS_PER_USER=3
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
LOG_LEVEL=info
