rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/botProfiles/{profileId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/pluginSettings/{settingId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/pluginPresets/{presetId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/waypoints/{waypointId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/macros/{macroId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/notifications/{notificationId} {
      allow read, write: if isOwner(uid);
    }

    match /botRuntime/{botId} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == resource.data.ownerUid);
      allow write: if false;
    }

    match /adminAudit/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /system/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pluginCatalog/{pluginId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /pluginUploads/{uploadId} {
      allow read: if isOwner(resource.data.ownerUid) || isAdmin();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerUid) || isAdmin();
    }
  }
}
